ALGORITMO "EXERCICIO 04 - CAPÍTULO 09"

VAR

   NOME_VENDEDOR: CARACTERE
   SALARIO_FIXO, VENDAS_MES, PERCENTUAL_COMISSAO, SALARIO_TOTAL: REAL
   
INICIO

      ESCREVAL("CALCULADORA DE SALARIOS DE VENDEDORES")
      ESCREVAL(" ")
      ESCREVA("INFORME O NOME DO VENDEDOR: ")
      LEIA(NOME_VENDEDOR)
      ESCREVA("INFORME O SALARIO FIXO DO VENDEDOR: ")
      LEIA(SALARIO_FIXO)
      ESCREVA("INFORME O TOTAL DE VENDAS REALIZADAS NO MES: ")
      LEIA(VENDAS_MES)
      ESCREVA("INFORME O % DA COMISSÃO SOBRE AS VENDAS: ")
      LEIA(PERCENTUAL_COMISSAO)

      SALARIO_TOTAL <- SALARIO_FIXO + VENDAS_MES * (PERCENTUAL_COMISSAO / 100)
      
      ESCREVAL("VENDEDOR: ", NOME_VENDEDOR, " - SALARIO: R$ ", SALARIO_TOTAL:2:2)
      
FIMALGORITMO
