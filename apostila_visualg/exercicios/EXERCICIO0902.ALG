ALGORITMO "DETERMINA O VOLUME DA CAIXA DAGUA CILINDRICA"

VAR
   RAIO, ALTURA, VOLUME: REAL
   
INICIO

      ESCREVAL("CALCULADORA DE VOLUME DE UMA CAIXA DAGUA CILINDRICA")
      ESCREVA("INFORME A ALTURA DO CILINDRO: ")
      LEIA(ALTURA)
      ESCREVA("INFORME O COMPRIMENTO DO RAIO: ")
      LEIA(RAIO)
      
      VOLUME <- PI * RAIO ^ 2 * ALTURA
      
      ESCREVAL("O VOLUME DO CILINDRO É: ", VOLUME:2:3, " U.V.")
      
FIMALGORITMO
