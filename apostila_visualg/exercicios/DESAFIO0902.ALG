ALGORITMO "DESAFIO 02 - CAPITULO 09"

VAR

   TROCO, NOTA1, NOTA2, NOTA5, NOTA10, NOTA20, NOTA50: INTEIRO
   
INICIO

      ESCREVAL("CALCULADORA DE TROCO: ")
      ESCREVA("INFORME O TROCO A SER DADO: ")
      LEIA(TROCO)
      
      NOTA50 <- TROCO \ 50
      NOTA20 <- (TROCO % 50) \ 20
      NOTA10 <- ((TROCO % 50) % 20) \ 10
      NOTA5 <- (((TROCO % 50) % 20) % 10) \ 5
      NOTA2 <- ((((TROCO % 50) % 20) % 10) % 5) \ 2
      NOTA1 <- (((((TROCO % 50) % 20) % 10) % 5) % 2)
      
      ESCREVAL("NOTAS DE R$ 50.00: ", NOTA50)
      ESCREVAL("NOTAS DE R$ 20.00: ", NOTA20)
      ESCREVAL("NOTAS DE R$ 10.00: ", NOTA10)
      ESCREVAL("NOTAS DE R$  5.00: ", NOTA5)
      ESCREVAL("NOTAS DE R$  2.00: ", NOTA2)
      ESCREVAL("NOTAS DE R$  1.00: ", NOTA1)
      
FIMALGORITMO
