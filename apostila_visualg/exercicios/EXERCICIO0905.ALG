ALGORITMO "EXERCICIO 05 - CAPITULO 09"

VAR

   NOME_PILOTO: CARACTERE
   DISTANCIA_PERCORRIDA, TEMPO_GASTO, VELOCIDADE: REAL
   
INICIO

      ESCREVAL("CALCULADORA DE VELOCIDADE DE VIAGEM")
      ESCREVAL(" ")
      ESCREVA("INFORME O NOME DO PILOTO: ")
      LEIA(NOME_PILOTO)
      ESCREVA("INFORME A DISTANCIA PERCORRIDA: ")
      LEIA(DISTANCIA_PERCORRIDA)
      ESCREVA("INFORME O TEMPO GASTO NA VIAGEM: ")
      LEIA(TEMPO_GASTO)
      
      VELOCIDADE <- DISTANCIA_PERCORRIDA / TEMPO_GASTO
      
      ESCREVAL("A velocidade média do ", NOME_PILOTO, " foi ", VELOCIDADE:2:2, " km/h.")
      
FIMALGORITMO
