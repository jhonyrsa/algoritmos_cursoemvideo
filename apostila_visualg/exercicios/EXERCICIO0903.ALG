ALGORITMO "SALARIO DO FUNCIONARIO"

VAR

   NOME_FUNCIONARIO: CARACTERE
   HORAS_TRABALHADAS, QUANTIDADE_FILHOS: INTEIRO
   VALOR_HORA, SALARIO: REAL
   
INICIO

      ESCREVAL("DETERMINA O SALÁRIO DO FUNCIONÁRIO")
      ESCREVA("INFORME O NOME DO FUNCIONARIO: ")
      LEIA(NOME_FUNCIONARIO)
      ESCREVA("INFORME A QUANTIDADE DE HORAS TRABALHADAS: ")
      LEIA(HORAS_TRABALHADAS)
      ESCREVA("INFORME O VALOR DA HORA DE TRABALHO: ")
      LEIA(VALOR_HORA)
      ESCREVA("INFORME A QUANTIDADE DE FILHOS DO FUNCIONÁRIO: ")
      LEIA(QUANTIDADE_FILHOS)
      
      SALARIO <- HORAS_TRABALHADAS * VALOR_HORA + HORAS_TRABALHADAS * VALOR_HORA * 0.03
      
      ESCREVAL("O SALARIO DE ", NOME_FUNCIONARIO, " É R$ ", SALARIO:2:2, ".")
      
FIMALGORITMO
