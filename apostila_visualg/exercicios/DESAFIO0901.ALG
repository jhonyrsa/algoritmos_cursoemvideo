ALGORITMO "DESAFIO 01 - CAPITULO 09"

VAR
   QTDE_CLIENTES, COBERTURAS, TULIPAS: INTEIRO
   VALOR_CONTA, VALOR_POR_PESSOA: REAL
   
INICIO

      ESCREVA("INFORME A QUANTIDADE DE CLIENTES: ")
      LEIA(QTDE_CLIENTES)
      ESCREVA("INFORME A QUANTIDADE DE TULIPAS DE CHOPP CONSUMIDAS: ")
      LEIA(TULIPAS)
      ESCREVA("INFORME A QUANTIDADE DE COBERTURAS ADICIONADAS A PIZZA: ")
      LEIA(COBERTURAS)

      VALOR_CONTA <- 10 + COBERTURAS * 1.50 + TULIPAS * 0.80
      VALOR_CONTA <- VALOR_CONTA * 1.10
      
      VALOR_POR_PESSOA <- VALOR_CONTA / QTDE_CLIENTES
      
      ESCREVAL("VALOR TOTAL: R$ ", VALOR_CONTA:2:2)
      ESCREVAL("VALOR POR PESSOA: R$ ", VALOR_POR_PESSOA:2:2)
      
FIMALGORITMO
