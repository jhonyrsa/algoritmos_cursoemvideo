ALGORITMO "EX1009"

VAR

   DINHEIRO: REAL
   
INICIO

      ESCREVAL("INFORME QUANTO DE DINHEIRO DISPONÍVEL R$ ")
      LEIA(DINHEIRO)
      
      SE DINHEIRO >= 10.00 ENTAO
         ESCREVAL("VA AO CINEMA")
      SENAO
           ESCREVAL("FIQUE EM CASA E ASSISTA TV")
      FIMSE
      
FIMALGORITMO
