ALGORITMO "EXEMPLO1007"

VAR

   RAIO: REAL
   AREA: REAL
   
INICIO

      ESCREVA("INFORME O RAIO DO CIRCULO: ")
      LEIA(RAIO)
      
      SE RAIO > 0 ENTAO
         AREA <- PI * RAIO * RAIO
         ESCREVAL("A AREA DO CIRCULO É: ", AREA:2:2, " U.A.")
      FIMSE
      SE RAIO <= 0 ENTAO
         ESCREVAL("O RAIO DO CIRCULO NÃO PODE SER NULO OU NEGATIVO")
      FIMSE

FIMALGORITMO
