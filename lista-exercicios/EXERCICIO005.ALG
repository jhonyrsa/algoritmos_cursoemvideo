ALGORITMO "EXERCICIO005"

VAR
   NOTA1, NOTA2, MEDIA: REAL

INICIO
      ESCREVA("NOTA 1: ")
      LEIA(NOTA1)
      ESCREVA("NOTA 2: ")
      LEIA(NOTA2)
      
      MEDIA <- (NOTA1 + NOTA2) / 2
      
      ESCREVAL()
      ESCREVAL("A MEDIA ENTRE ", NOTA1:2:1, " E ", NOTA2:2:1, " É IGUAL A ", MEDIA:2:1)
      
FIMALGORITMO
