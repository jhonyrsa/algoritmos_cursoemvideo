ALGORITMO "EXERCICIO016"

VAR

   QDE_CIGARROS, QDE_ANOS_FUMANDO: INTEIRO
   TEMPO_PERDIDO: REAL
   
INICIO

      ESCREVA("INFORME A QUANTIDADE DE CIGARROS FUMADOS POR DIA: ")
      LEIA(QDE_CIGARROS)
      ESCREVA("INFORME A QUANTIDADE DE ANOS FUMANDO: ")
      LEIA(QDE_ANOS_FUMANDO)
      
      TEMPO_PERDIDO <- ((QDE_CIGARROS * QDE_ANOS_FUMANDO * 365) * 10)/(60 * 24)
      
      ESCREVAL("O TEMPO DE VIDA FOI REDUZIDO EM ", TEMPO_PERDIDO:2:1, " EM DIAS.")
      
FIMALGORITMO
