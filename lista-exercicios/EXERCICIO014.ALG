ALGORITMO "EXERCICIO014"

VAR

   DIAS_ALUGADO: INTEIRO
   KM_RODADOS: REAL
   VALOR_ALUGUEL: REAL
   
INICIO

      ESCREVA("INFORME A QUANTIDADE DE DIAS QUE O CARRO FICOU ALUGADO: ")
      LEIA(DIAS_ALUGADO)
      ESCREVA("INFORME A QUANTIDADE DE QUILOMETROS RODADOS: ")
      LEIA(KM_RODADOS)
      
      VALOR_ALUGUEL <- DIAS_ALUGADO * 90 + KM_RODADOS * 0.20
      
      ESCREVAL("VALOR DO ALUGUEL: R$ ", VALOR_ALUGUEL:2:2)
      
FIMALGORITMO
