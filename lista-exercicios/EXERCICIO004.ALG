ALGORITMO "EXERCICIO004"

VAR
   VALOR1, VALOR2, SOMA: INTEIRO
   
INICIO
      ESCREVA("DIGITE UM VALOR: ")
      LEIA(VALOR1)
      ESCREVA("DIGITE OUTRO VALOR: ")
      LEIA(VALOR2)
      
      SOMA <- VALOR1 + VALOR2
      
      ESCREVAL()
      ESCREVAL("A SOMA ENTRE ", VALOR1, " E ", VALOR2, " É IGUAL A ", SOMA)
      
FIMALGORITMO
