ALGORITMO "EXERCICIO008"

VAR

   DISTANCIA: REAL
   
INICIO

      ESCREVA("DIGITE UMA DISTANCIA EM METROS: ")
      LEIA(DISTANCIA)
      
      ESCREVAL("A DISTANCIA DE ", DISTANCIA, " m CORRESPONDE A:")
      ESCREVAL((DISTANCIA / 1000):6, " km")
      ESCREVAL((DISTANCIA / 100):6, " Hm")
      ESCREVAL((DISTANCIA / 10):6, " Dm")
      ESCREVAL((DISTANCIA / 0.1):6:1, " dm")
      ESCREVAL((DISTANCIA / 0.01):6:1, " cm")
      ESCREVAL((DISTANCIA / 0.001):6:1, " mm")
      
FIMALGORITMO
