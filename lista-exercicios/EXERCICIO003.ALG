ALGORITMO "EXERCICIO003"

VAR

   NOME_FUNCIONARIO: CARACTERE
   SALARIO: REAL
   
INICIO

      ESCREVA("NOME DO FUNCIONARIO: ")
      LEIA(NOME_FUNCIONARIO)
      ESCREVA("SALARIO: ")
      LEIA(SALARIO)
      
      ESCREVAL("O FUNCIONARIO ", NOME_FUNCIONARIO, " TEM UM SALÁRIO DE R$ ", SALARIO:2:2, " NO MES DE JUNHO.")
      
FIMALGORITMO
